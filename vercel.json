{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "dub1"
  ],
  "fluid": true,
  "functions": {
    "api/quizzes.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/rooms/:action",
      "destination": "/api/rooms?action=:action"
    },
    {
      "source": "/api/game/:action",
      "destination": "/api/game?action=:action"
    },
    {
      "source": "/api/quizzes/:id/:extra",
      "destination": "/api/quizzes?id=:id&extra=:extra"
    },
    {
      "source": "/api/quizzes/:id",
      "destination": "/api/quizzes?id=:id"
    },
    {
      "source": "/api/challenges/:id/:extra",
      "destination": "/api/challenges?id=:id&extra=:extra"
    },
    {
      "source": "/api/challenges/:id",
      "destination": "/api/challenges?id=:id"
    },
    {
      "source": "/api/reports/:id",
      "destination": "/api/reports?id=:id"
    },
    {
      "source": "/api/account/:action",
      "destination": "/api/account?action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'sha256-nCXtnUfsdYIoxVfHxGIliBW5MXULm1WWuBOzTwfvPL0='; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
