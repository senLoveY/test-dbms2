# Frontend (Vite) — prefix VITE_
# Project URL only — без /rest/v1/ и без слэша в конце
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel Serverless API (Project Settings -> Environment Variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Генерация тестов (DeepSeek). Без ключа кнопка в редакторе вернёт ошибку.
DEEPSEEK_API_KEY=your-deepseek-api-key
