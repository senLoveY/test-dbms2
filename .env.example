# Frontend (Vite) — prefix VITE_
# Project URL only — без /rest/v1/ и без слэша в конце
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel Serverless API (Project Settings -> Environment Variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Необязательно: для проектов с legacy HS256 JWT — локальная проверка токена без запроса в Auth
# SUPABASE_JWT_SECRET=your-jwt-secret

# Мониторинг ошибок (Sentry), необязательно: без DSN ничего не отправляется.
# Один и тот же DSN для обоих; VITE_ — для браузера (подставляется при сборке), без префикса — для API.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>

# Генерация тестов (DeepSeek). Без ключа кнопка в редакторе вернёт ошибку.
DEEPSEEK_API_KEY=your-deepseek-api-key
